            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;name&quot;:&quot;Perf Location Updated ${run_id}&quot;,&quot;address&quot;:&quot;Perf Street 2&quot;,&quot;phone&quot;:&quot;+37062222222&quot;,&quot;domain&quot;:&quot;perf-location-updated-${run_id}.example.test&quot;,&quot;companyId&quot;:&quot;${created_company_id}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
